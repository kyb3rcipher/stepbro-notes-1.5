<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <% if (isDev) { %>
        <script type="module" src="<%= viteUrl %>/@vite/client" data-turbo-track="reload"></script>
        <script type="module" src="<%= viteUrl %>/src/main.js" data-turbo-track="reload"></script>
    <% } else { %>
        <link rel="stylesheet" href="/assets/main.css" data-turbo-track="reload">
        <script type="module" src="/assets/main.js" data-turbo-track="reload"></script>
    <% } %>
</head>
<body>
    <%- body %>
</body>
</html>